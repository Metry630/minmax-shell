// Source config for the Worker. nitro merges this into the generated .output/server/wrangler.json
// at build time, overriding only `main` and `assets` (node_modules/nitro/dist/_presets.mjs,
// writeWranglerConfig). Edit this file, never the generated one.
{
  "name": "minmax",
  "compatibility_date": "2026-10-04",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // armbar.day: bought 2026-10-06 at Namecheap, nameservers on Cloudflare. Custom domains make their
  // own DNS records and certificates; workers.dev keeps working for tests. www is served too, and
  // src/kit/hosts.ts maps both to guard (it strips www).
  // Explicit, because with routes present wrangler turns workers.dev off unless told otherwise.
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    { "pattern": "armbar.day", "custom_domain": true },
    { "pattern": "www.armbar.day", "custom_domain": true },
  ],
  "d1_databases": [
    {
      // Created 2026-10-04 with --location enam: the BJJ audience is mostly American.
      "binding": "DB",
      "database_name": "minmax",
      "database_id": "bb9cd6ed-d66e-49d1-84db-d6bddb6c1e1f",
      "migrations_dir": "migrations",
    },
  ],
}
